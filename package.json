{
  "name": "two-stages",
  "version": "2.0.0",
  "private": true,
  "description": "主图批量生成工具（重构版）",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node esbuild.mjs && vite build",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "mock": "tsx scripts/mock-relay.ts",
    "seed": "node scripts/update-seed.mjs"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@lucide/vue": "^1.61.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "multer": "^2.5.0",
    "pinia": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13",
    "zod": "^4.6.7"
  }
}
